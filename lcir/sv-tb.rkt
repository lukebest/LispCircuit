#lang racket
;; Testbench for a defsystem. Samples at negedge so $display sees the
;; pre-update state, matching the ESL Work/Xfer split.

(require "nhir.rkt" "sv.rkt" "ast.rkt")
(provide emit-tb)

(define (sv-log guard level parts)
  (define fmt "[cyc %0d]")
  (define args '("cyc"))
  (set! fmt (string-append fmt " " level))
  (let loop ([ps parts])
    (unless (null? ps)
      (define item (car ps))
      (cond
        [(eq? (car item) 'key)
         (set! fmt (string-append fmt " " (cadr item) "="))
         (loop (cdr ps))]
        [else
         (define-values (f as) (sv-fmt (cadr item)))
         (set! fmt (string-append fmt f))
         (set! args (append args as))
         (loop (cdr ps))])))
  (format "        if (~a) $display(\"%s\", $sformatf(\"~a\"~a));"
          guard fmt
          (if (null? (cdr args)) ""
              (string-append ", " (string-join args ", ")))))

(define (emit-tb sys cycles)
  (define clocks (hmod-clocks sys))
  (define primary (if (memq 'clk clocks) 'clk (car clocks)))
  (define finish-guards
    (for/list ([s (hmod-sides sys)] #:when (eq? (hside-kind s) 'finish))
      (sv-expr (hside-guard s))))
  (define finish-expr
    (if (null? finish-guards) "1'b0" (string-join finish-guards " || ")))
  (define checks
    (for/list ([s (hmod-sides sys)] #:when (eq? (hside-kind s) 'check))
      (match-define (list expr msg) (hside-data s))
      (format "        if (~a && !(~a)) $fatal(1, \"%s\", ~a);"
              (sv-expr (hside-guard s))
              (sv-expr expr)
              (sv-string msg))))
  (define logs
    (for/list ([s (hmod-sides sys)] #:when (eq? (hside-kind s) 'log))
      (match-define (list level parts) (hside-data s))
      (sv-log (sv-expr (hside-guard s)) level parts)))
  (string-append
   "// Generated by LCIR.\n"
   "/* verilator lint_off UNUSED */\n"
   "/* verilator lint_off UNUSEDSIGNAL */\n"
   "/* verilator lint_off MULTIDRIVEN */\n"
   "`include \"lcir_types.sv\"\n"
   (format "module tb_~a;\n" (sv-name (hmod-name sys)))
   (apply string-append
          (for/list ([c clocks])
            (format "  logic ~a = 0;\n  always #5 ~a = ~~~a;\n" (sv-name c) (sv-name c) (sv-name c))))
   "  logic rst = 1;\n"
   (emit-module sys #:wrapped #f)
   (format "  wire finish_w = ~a;\n" finish-expr)
   "  initial begin\n"
   (format "    @(posedge ~a);\n" (sv-name primary))
   (format "    @(negedge ~a);\n" (sv-name primary))
   "    rst = 0;\n"
   (format "    for (int cyc = 0; cyc < ~a; cyc = cyc + 1) begin\n" cycles)
   (string-join checks "\n")
   (if (null? checks) "" "\n")
   (string-join logs "\n")
   (if (null? logs) "" "\n")
   "        if (finish_w) $finish;\n"
   (format "        @(posedge ~a);\n" (sv-name primary))
   (format "        @(negedge ~a);\n" (sv-name primary))
   "    end\n"
   "    $finish;\n"
   "  end\n"
   "endmodule\n"))
