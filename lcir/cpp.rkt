#lang racket
;; Target 2: standalone C++17 cycle simulator.
;; Mirrors esl.rkt exactly: silent reset cycle, then per cycle
;; Eval -> Check -> Log -> Xfer, logs formatted like `fmt-val`.

(require "lower-bits.rkt" "types.rkt" "diag.rkt" "flatten.rkt")
(provide emit-cpp-sim cpp-ident)

(define (cpp-ident s)
  (string-append "v_" (regexp-replace* #rx"[^A-Za-z0-9_]" (format "~a" s) "_")))

(define (cstr s)
  (string-append
   "\""
   (apply string-append
          (for/list ([c (format "~a" s)])
            (cond [(char=? c #\") "\\\""] [(char=? c #\\) "\\\\"] [(char=? c #\newline) "\\n"]
                  [else (string c)])))
   "\""))

(define (too-wide! what w)
  (fail! (diag-at "ERR_BACKEND" (info (format "cpp:~a" what) #f #f #f)
                  #:message (format "~a is ~a bits; the C++ backend supports at most 64" what w)
                  #:suggestion "Use the esl or sv backend for this design")))

;; mem-ref: table name -> C++ expression for the current memory array.
(define (cx e)
  (define w (bv-w e))
  (when (> w 64) (too-wide! "an intermediate value" w))
  (define (a i) (cx (list-ref (bv-args e) i)))
  (define (aw i) (bv-w (list-ref (bv-args e) i)))
  (match (bv-op e)
    ['const (format "UINT64_C(~a)" (car (bv-args e)))]
    ['var (cpp-ident (car (bv-args e)))]
    ['tread (format "rd(~a, ~a)" (cpp-ident (car (bv-args e))) (cx (cadr (bv-args e))))]
    ['add (format "M(~a + ~a, ~a)" (a 0) (a 1) w)]
    ['sub (format "M(~a - ~a, ~a)" (a 0) (a 1) w)]
    ['mul (format "M(~a * ~a, ~a)" (a 0) (a 1) w)]
    ['and (format "(~a & ~a)" (a 0) (a 1))]
    ['or (format "(~a | ~a)" (a 0) (a 1))]
    ['xor (format "(~a ^ ~a)" (a 0) (a 1))]
    ['not (format "M(~~~a, ~a)" (a 0) w)]
    ['zext (a 0)]
    ['sext (format "M((uint64_t)S(~a, ~a), ~a)" (a 0) (aw 0) w)]
    ['extract (format "M(~a >> ~a, ~a)" (a 0) (cadr (bv-args e)) w)]
    ['concat
     (define parts (bv-args e))
     (let loop ([ps parts] [acc #f])
       (cond
         [(null? ps) (or acc "UINT64_C(0)")]
         [else
          (define p (car ps))
          (define lo (apply + (map bv-w (cdr ps))))
          (define term (if (= lo 0) (cx p) (format "(~a << ~a)" (cx p) lo)))
          (loop (cdr ps) (if acc (format "(~a | ~a)" acc term) term))]))]
    ['ite (format "(~a ? ~a : ~a)" (a 0) (a 1) (a 2))]
    ['shl (format "shl(~a, ~a, ~a)" (a 0) (a 1) w)]
    ['lshr (format "lshr(~a, ~a, ~a)" (a 0) (a 1) w)]
    ['ashr (format "ashr(~a, ~a, ~a)" (a 0) (a 1) w)]
    ['eq (format "(uint64_t)(~a == ~a)" (a 0) (a 1))]
    ['ult (format "(uint64_t)(~a < ~a)" (a 0) (a 1))]
    ['ule (format "(uint64_t)(~a <= ~a)" (a 0) (a 1))]
    ['slt (format "(uint64_t)(S(~a, ~a) < S(~a, ~a))" (a 0) (aw 0) (a 1) (aw 1))]
    ['sle (format "(uint64_t)(S(~a, ~a) <= S(~a, ~a))" (a 0) (aw 0) (a 1) (aw 1))]))

;; C++ expression of type std::string formatting raw value `x` of type t.
(define (fmt-cx t x)
  (match t
    [(ty-uint _) (format "std::to_string(~a)" x)]
    [(ty-sint w) (format "std::to_string(S(~a, ~a))" x w)]
    [(ty-enum _ vs)
     (format "fmt_enum(~a, {~a})" x (string-join (map cstr vs) ", "))]
    [(ty-bundle fs)
     (define parts
       (let loop ([fs fs])
         (cond
           [(null? fs) '()]
           [else
            (define lo (apply + (map (lambda (f) (ty-width (cdr f))) (cdr fs))))
            (define fx (format "M(~a >> ~a, ~a)" x lo (ty-width (cdar fs))))
            (cons (format "std::string(~a) + ~a" (cstr (format "~a=" (caar fs))) (fmt-cx (cdar fs) fx))
                  (loop (cdr fs)))])))
     (format "(std::string(\"{\") + ~a + \"}\")" (string-join parts " + \",\" + "))]
    [(ty-vec n et)
     (define ew (ty-width et))
     (define parts
       (for/list ([i (in-range n)])
         (fmt-cx et (format "M(~a >> ~a, ~a)" x (* (- n 1 i) ew) ew))))
     (format "(std::string(\"[\") + ~a + \"]\")" (string-join parts " + \",\" + "))]
    [_ (format "std::to_string(~a)" x)]))

(define prelude #<<CPP
// Generated by LispCircuit (Target 2: C++ cycle simulator). Do not edit.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <initializer_list>
#include <string>
#include <vector>

static inline uint64_t M(uint64_t x, int w) { return w >= 64 ? x : (x & ((UINT64_C(1) << w) - 1)); }
static inline int64_t S(uint64_t x, int w) {
  return w >= 64 ? (int64_t)x : (int64_t)(x << (64 - w)) >> (64 - w);
}
static inline uint64_t shl(uint64_t a, uint64_t b, int w) { return b >= (uint64_t)w ? 0 : M(a << b, w); }
static inline uint64_t lshr(uint64_t a, uint64_t b, int w) { return b >= (uint64_t)w ? 0 : (a >> b); }
static inline uint64_t ashr(uint64_t a, uint64_t b, int w) {
  if (b >= (uint64_t)w) return S(a, w) < 0 ? M(~UINT64_C(0), w) : 0;
  return M((uint64_t)(S(a, w) >> b), w);
}
static inline uint64_t rd(const std::vector<uint64_t>& m, uint64_t a) { return a < m.size() ? m[a] : 0; }
static std::string fmt_enum(uint64_t x, std::initializer_list<const char*> names) {
  return x < names.size() ? std::string(names.begin()[x]) : std::to_string(x);
}

CPP
  )

(define (emit-cpp-sim flat #:cycles cycles #:top-name top-name)
  (define net (lower-net flat))
  (define regs (lnet-regs net))
  (define tables (lnet-tables net))
  (define (chk-ty! name t) (when (> (ty-width t) 64) (too-wide! name (ty-width t))))
  (for ([r regs]) (chk-ty! (lreg-name r) (lreg-ty r)))
  (for ([w (lnet-wires net)]) (chk-ty! (lwire-name w) (lwire-ty w)))
  (for ([t tables]) (chk-ty! (ltable-name t) (ltable-ty t)))
  (define o (open-output-string))
  (define (p . xs) (for ([x xs]) (display x o)) (newline o))
  (display prelude o)
  (p "// system " top-name)
  (p "struct State {")
  (for ([r regs]) (p "  uint64_t " (cpp-ident (lreg-name r)) " = UINT64_C(" (lreg-init r) ");"))
  (for ([t tables])
    (p "  std::vector<uint64_t> " (cpp-ident (ltable-name t)) " = std::vector<uint64_t>(" (ltable-depth t) ", 0);")
    (when (ltable-rdata t) (p "  uint64_t " (cpp-ident (ltable-rdata t)) " = 0;")))
  (p "};")
  (p "")
  ;; Eval: bind state to locals, compute wires in topological order, then
  ;; run the given phase body. A macro-free way to share the binding code
  ;; is to generate one function per cycle that does everything.
  (p "// Returns: 0 continue, 1 finish, 2 check failure.")
  (p "static int step(State& st, long cyc, bool reset) {")
  (for ([r regs]) (p "  const uint64_t " (cpp-ident (lreg-name r)) " = st." (cpp-ident (lreg-name r)) ";"))
  (for ([t tables])
    (p "  const std::vector<uint64_t>& " (cpp-ident (ltable-name t)) " = st." (cpp-ident (ltable-name t)) ";")
    (when (ltable-rdata t)
      (p "  const uint64_t " (cpp-ident (ltable-rdata t)) " = st." (cpp-ident (ltable-rdata t)) ";")))
  (for ([w (lnet-wires net)])
    (p "  const uint64_t " (cpp-ident (lwire-name w)) " = " (cx (lwire-expr w)) ";"))
  (p "  if (!reset) {")
  (define (snapshot-code)
    (string-join
     (for/list ([r regs] [i (in-naturals)])
       (format "~a\"\\\"~a\\\":\\\"\" + ~a + \"\\\"\""
               (if (= i 0) "" "\",\" + ")
               (lreg-name r)
               (fmt-cx (lreg-ty r) (cpp-ident (lreg-name r)))))
     " + "))
  (define (fail-code msg-cx)
    (format "{ std::string snap = std::string(\"{\") + ~a + \"}\"; std::fprintf(stderr, \"ERR_CHECK\\n  message: cycle %ld: %s\\n  fix: %s\\n\", cyc, ~a, snap.c_str()); return 2; }"
            (if (null? regs) "\"\"" (snapshot-code)) msg-cx))
  (for ([c (lnet-checks net)])
    (p "    if (" (cx (lcheck-guard c)) " && !" (cx (lcheck-expr c)) ") "
       (fail-code (cstr (lcheck-msg c)))))
  (for ([x (lnet-excl net)] #:when (memq (cadr x) '(exclusive cf)))
    (p "    if ((" (string-join (map (lambda (g) (format "(int)(~a != 0)" (cx g))) (caddr x)) " + ") ") > 1) "
       (fail-code (cstr (format "conflicting rules both fired for ~a (~a)" (car x) (cadr x))))))
  (for ([l (lnet-logs net)])
    (p "    if (" (cx (llog-guard l)) ") {")
    (p "      std::string line = \"[cyc \" + std::to_string(cyc) + \"] \" + " (cstr (llog-level l)) ";")
    (for ([part (llog-parts l)])
      (p "      line += std::string(" (cstr (format " ~a=" (car part))) ") + "
         (fmt-cx (cadr part) (cx (cddr part))) ";"))
    (p "      std::puts(line.c_str());")
    (p "    }"))
  (p "  }")
  (p "  bool fin = false;")
  (unless (null? (lnet-finishes net))
    (p "  if (!reset && (" (string-join (map (lambda (g) (format "~a" (cx g))) (lnet-finishes net)) " || ") ")) fin = true;"))
  ;; Xfer: compute all new values from the old state, then commit.
  (for ([r regs] [i (in-naturals)])
    (define nm (cpp-ident (lreg-name r)))
    (define keep (if (lreg-reset-less? r) "false" "reset"))
    (p "  const uint64_t n" i " = " keep " ? UINT64_C(" (lreg-init r) ") : (" (cx (lreg-we r)) " ? "
       (cx (lreg-next r)) " : " nm ");"))
  (for ([t tables] [i (in-naturals)])
    (define nm (cpp-ident (ltable-name t)))
    (when (ltable-rdata t)
      (p "  const uint64_t r" i " = reset ? 0 : (" (cx (ltable-ren t)) " ? rd(" nm ", " (cx (ltable-raddr t)) ") : "
         (cpp-ident (ltable-rdata t)) ");"))
    (p "  const bool we" i " = " (cx (ltable-wen t)) " != 0;")
    (p "  const uint64_t wa" i " = " (cx (ltable-waddr t)) ", wd" i " = " (cx (ltable-wdata t)) ";"))
  (for ([r regs] [i (in-naturals)]) (p "  st." (cpp-ident (lreg-name r)) " = n" i ";"))
  (for ([t tables] [i (in-naturals)])
    (when (ltable-rdata t) (p "  st." (cpp-ident (ltable-rdata t)) " = r" i ";"))
    (p "  if (we" i " && wa" i " < st." (cpp-ident (ltable-name t)) ".size()) st." (cpp-ident (ltable-name t))
       "[wa" i "] = wd" i ";"))
  (p "  return fin ? 1 : 0;")
  (p "}")
  (p "")
  (p "int main(int argc, char** argv) {")
  (p "  long cycles = argc > 1 ? std::atol(argv[1]) : " cycles ";")
  (p "  State st;")
  (p "  step(st, -1, true);")
  (p "  for (long cyc = 0; cyc < cycles; ++cyc) {")
  (p "    int r = step(st, cyc, false);")
  (p "    if (r == 2) return 1;")
  (p "    if (r == 1) break;")
  (p "  }")
  (p "  return 0;")
  (p "}")
  (get-output-string o))
