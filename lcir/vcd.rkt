#lang racket
;; VCD dump of ports and registers. FST is produced by vcd2fst when asked.

(require "types.rkt" "bits.rkt" "flatten.rkt")
(provide vcd-dump open-vcd vcd-change vcd-close)

(struct vcd (port codes last) #:transparent #:mutable)

(define (code-name i)
  (let loop ([n i] [acc '()])
    (if (negative? n)
        (list->string acc)
        (loop (sub1 (quotient n 94))
              (cons (integer->char (+ 33 (remainder n 94))) acc)))))

(define (leaf-signals name v ty)
  (match ty
    [(or (ty-uint _) (ty-sint _) (ty-enum _ _))
     (list (list name v (ty-width ty)))]
    [(ty-bundle fs)
     (append-map (lambda (f)
                   (leaf-signals (string->symbol (format "~a.~a" name (car f)))
                                 (hash-ref v (car f))
                                 (cdr f)))
                 fs)]
    [(ty-vec n e)
     (append-map (lambda (i)
                   (leaf-signals (string->symbol (format "~a[~a]" name i))
                                 (vector-ref v i)
                                 e))
                 (range n))]))

(define (bits-string v width)
  (define raw (modulo v (expt 2 width)))
  (define digits (number->string raw 2))
  (string-append (make-string (max 0 (- width (string-length digits))) #\0) digits))

(define (emit-value out id width raw)
  (if (= width 1)
      (fprintf out "~a~a\n" (if (zero? (bitwise-and raw 1)) "0" "1") id)
      (fprintf out "b~a ~a\n" (bits-string raw width) id)))

(define (hier-name sym)
  (string-split (symbol->string sym) "__"))

(define (open-vcd path flat state top-name)
  (define out (open-output-file path #:exists 'replace))
  (fprintf out "$date ~a $end\n" (seconds->date (current-seconds)))
  (fprintf out "$version LCIR $end\n$timescale 1ns $end\n")
  (define signals '())
  ;; regs and port wires
  (define items
    (append
     (for/list ([r (flatnet-regs flat)])
       (list (freg-name r) (hash-ref state (freg-name r)) (freg-ty r)))
     (for/list ([w (flatnet-wires flat)] #:when (fwire-port? w))
       (list (fwire-name w) (hash-ref state (fwire-name w) 0) (fwire-ty w)))))
  (define flat-sigs '())
  (for ([it items])
    (match-define (list name v ty) it)
    (set! flat-sigs (append flat-sigs (leaf-signals name v ty))))
  (define codes (make-hash))
  (define i 0)
  (fprintf out "$scope module ~a $end\n" top-name)
  (define scope '())
  (for ([s flat-sigs])
    (match-define (list name _ w) s)
    (define parts (hier-name name))
    (define dirs (drop-right parts 1))
    (define leaf (last parts))
    (define shared (let loop ([a scope] [b dirs])
                     (if (and (pair? a) (pair? b) (equal? (car a) (car b)))
                         (add1 (loop (cdr a) (cdr b)))
                         0)))
    (for ([_ (in-range (- (length scope) shared))])
      (fprintf out "$upscope $end\n"))
    (for ([d (drop dirs shared)])
      (fprintf out "$scope module ~a $end\n" d))
    (set! scope dirs)
    (define id (code-name i))
    (set! i (add1 i))
    (hash-set! codes name id)
    (fprintf out "$var wire ~a ~a ~a $end\n" w id leaf))
  (for ([_ scope]) (fprintf out "$upscope $end\n"))
  (fprintf out "$upscope $end\n$enddefinitions $end\n")
  (define dump (vcd out codes (make-hash)))
  (fprintf out "#0\n$dumpvars\n")
  (for ([s flat-sigs])
    (match-define (list name v w) s)
    (define raw (modulo v (expt 2 w)))
    (emit-value out (hash-ref codes name) w raw)
    (hash-set! (vcd-last dump) name raw))
  (fprintf out "$end\n")
  dump)

(define (vcd-change dump time flat state)
  (define out (vcd-port dump))
  (fprintf out "#~a\n" time)
  (define items
    (append
     (for/list ([r (flatnet-regs flat)])
       (list (freg-name r) (hash-ref state (freg-name r)) (freg-ty r)))
     (for/list ([w (flatnet-wires flat)] #:when (fwire-port? w))
       (list (fwire-name w) (hash-ref state (fwire-name w) 0) (fwire-ty w)))))
  (for ([it items])
    (match-define (list name v ty) it)
    (for ([s (leaf-signals name v ty)])
      (match-define (list nm val w) s)
      (define raw (modulo val (expt 2 w)))
      (unless (equal? raw (hash-ref (vcd-last dump) nm #f))
        (emit-value out (hash-ref (vcd-codes dump) nm) w raw)
        (hash-set! (vcd-last dump) nm raw)))))

(define (vcd-close dump)
  (close-output-port (vcd-port dump)))

(define (vcd-dump path flat state0 states top-name)
  (define d (open-vcd path flat state0 top-name))
  (for ([st states] [i (in-naturals 1)])
    (vcd-change d (* i 10) flat st))
  (vcd-close d))
