#lang racket
;; Combinational loop detection (Tarjan) and a topological order for ESL.

(require "diag.rkt" "ast.rkt" "flatten.rkt")
(provide check-loops! topo-order)

(define (wire-deps expr wire-names)
  (define ds '())
  (expr-each
   (lambda (n)
     (when (and (e-ref? n) (set-member? wire-names (e-ref-name n)))
       (set! ds (cons (e-ref-name n) ds))))
   expr)
  (remove-duplicates ds))

(define (build-graph wires)
  (define names (map fwire-name wires))
  (define name-set (list->set names))
  (define succs (make-hash))
  (define preds (make-hash))
  (for ([n names])
    (hash-set! succs n '())
    (hash-set! preds n '()))
  (for ([w wires])
    (for ([d (wire-deps (fwire-expr w) name-set)])
      ;; d must be computed before w
      (hash-update! succs d (lambda (s) (cons (fwire-name w) s)) '())
      (hash-update! preds (fwire-name w) (lambda (s) (cons d s)) '())))
  (values names succs preds))

(define (tarjan names succs)
  (define index (make-hash))
  (define low (make-hash))
  (define onstack (make-hash))
  (define stack '())
  (define sccs '())
  (define i 0)
  (define (strong v)
    (hash-set! index v i)
    (hash-set! low v i)
    (set! i (add1 i))
    (set! stack (cons v stack))
    (hash-set! onstack v #t)
    (for ([w (hash-ref succs v '())])
      (cond
        [(not (hash-has-key? index w))
         (strong w)
         (hash-set! low v (min (hash-ref low v) (hash-ref low w)))]
        [(hash-ref onstack w #f)
         (hash-set! low v (min (hash-ref low v) (hash-ref index w)))]))
    (when (= (hash-ref low v) (hash-ref index v))
      (define comp '())
      (let pull ()
        (define w (car stack))
        (set! stack (cdr stack))
        (hash-set! onstack w #f)
        (set! comp (cons w comp))
        (unless (eq? w v) (pull)))
      (set! sccs (cons comp sccs))))
  (for ([n names])
    (unless (hash-has-key? index n) (strong n)))
  sccs)

(define (self-edge? n succs)
  (memq n (hash-ref succs n '())))

(define (find-cycle nodes succs)
  (define inset (list->set nodes))
  (define (neighbors n)
    (filter (lambda (m) (set-member? inset m)) (hash-ref succs n '())))
  (cond
    [(ormap (lambda (n) (and (memq n (neighbors n)) (list n n))) nodes) => values]
    [else
     (define color (make-hash))
     (define parent (make-hash))
     (define cycle #f)
     (define (dfs u)
       (hash-set! color u 'gray)
       (for ([v (neighbors u)] #:unless cycle)
         (case (hash-ref color v #f)
           [(gray)
            (define path (let loop ([x u] [acc (list v)])
                           (if (or (not x) (eq? x v)) (cons v acc)
                               (loop (hash-ref parent x #f) (cons x acc)))))
            (set! cycle path)]
           [(black) (void)]
           [else
            (hash-set! parent v u)
            (dfs v)]))
       (hash-set! color u 'black))
     (for ([n nodes] #:unless cycle) (dfs n))
     (or cycle (append nodes (list (car nodes))))]))

(define (check-loops! flat [fallback-info #f])
  (define wires (flatnet-wires flat))
  (define-values (names succs preds) (build-graph wires))
  (define sccs (tarjan names succs))
  (for ([comp sccs])
    (when (or (> (length comp) 1) (and (= (length comp) 1) (self-edge? (car comp) succs)))
      (define cyc (map (lambda (s) (symbol->string s)) (find-cycle comp succs)))
      (define info (or (and (pair? wires) (fwire-info (car wires))) fallback-info))
      (fail! (diag-at "ERR_COMB_LOOP" info
                      #:message (format "combinational cycle: ~a" (string-join cyc " -> "))
                      #:loop cyc
                      #:suggestion (format "Combinational cycle: ~a" (string-join cyc " -> "))))))
  (topo-from names preds succs))

(define (topo-from names preds succs)
  (define indeg (make-hash))
  (for ([n names]) (hash-set! indeg n (length (remove-duplicates (hash-ref preds n '())))))
  (define q (filter (lambda (n) (zero? (hash-ref indeg n))) names))
  (define out '())
  (let loop ([q q])
    (unless (null? q)
      (define n (car q))
      (set! out (cons n out))
      (define q2 (cdr q))
      (for ([s (remove-duplicates (hash-ref succs n '()))])
        (hash-set! indeg s (sub1 (hash-ref indeg s)))
        (when (zero? (hash-ref indeg s))
          (set! q2 (cons s q2))))
      (loop q2)))
  (reverse out))

(define (topo-order flat)
  (define wires (flatnet-wires flat))
  (define-values (names succs preds) (build-graph wires))
  (define order-names (topo-from names preds succs))
  (define by-name (for/hash ([w wires]) (values (fwire-name w) w)))
  (map (lambda (n) (hash-ref by-name n)) order-names))
