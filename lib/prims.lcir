;; Built-in microarchitecture primitives.
;; stream-slice-forward : valid/data registered, ready is combinational.
;; stream-slice-backward: ready is registered (skid holds one beat).
;; stream-slice-skid    : both valid and ready paths are registered.
;; sync-fifo            : single-clock FIFO, power-of-two depth.
;; async-fifo           : gray pointers and 2-flop synchronizers.
;;                       ESL steps every clock together; tie clk_w and clk_r
;;                       for cycle-accurate comparison with the SV netlist.
;; elastic-pipeline     : N forward stages generated by gen-for.

(defmodule stream-slice-forward
  :params ((W 8))
  :ports ((in s_in (stream (uint W)))
          (out s_out (stream (uint W))))
  :state ((full :type (uint 1) :init 0)
          (data :type (uint W) :init 0 :reset-less t))
  :comb ((wire fire_in (uint 1) (and (valid s_in) (ready s_in)))
         (wire fire_out (uint 1) (and (valid s_out) (ready s_out)))
         (assign (ready s_in) (or (not full) (ready s_out)))
         (assign (valid s_out) full)
         (assign (bits s_out) data))
  (defrule load
    :guard fire_in
    :body ((set! data (bits s_in))))
  (defrule upd
    :guard 1
    :body ((set! full (or fire_in (and full (not fire_out)))))))

(defmodule stream-slice-backward
  :params ((W 8))
  :ports ((in s_in (stream (uint W)))
          (out s_out (stream (uint W))))
  :state ((skid_v :type (uint 1) :init 0)
          (skid_d :type (uint W) :init 0 :reset-less t))
  :comb ((assign (ready s_in) (not skid_v))
         (assign (valid s_out) (or (valid s_in) skid_v))
         (assign (bits s_out) (mux skid_v skid_d (bits s_in)))
         (wire cap (uint 1) (and (valid s_in) (ready s_in) (not (ready s_out))))
         (wire drain (uint 1) (or (ready s_out) (not (valid s_out)))))
  (defrule capture
    :guard cap
    :body ((set! skid_v 1)
           (set! skid_d (bits s_in))))
  (defrule clear
    :guard drain
    :body ((set! skid_v 0))))

(defmodule stream-slice-skid
  :params ((W 8))
  :ports ((in s_in (stream (uint W)))
          (out s_out (stream (uint W))))
  :state ((v :type (uint 1) :init 0)
          (d :type (uint W) :init 0 :reset-less t)
          (skid_v :type (uint 1) :init 0)
          (skid_d :type (uint W) :init 0 :reset-less t))
  :comb ((assign (ready s_in) (not skid_v))
         (assign (valid s_out) v)
         (assign (bits s_out) d)
         (wire fire_in (uint 1) (and (valid s_in) (ready s_in)))
         (wire fire_out (uint 1) (and (valid s_out) (ready s_out))))
  (defrule step
    :guard 1
    :body ((set! v (mux fire_out
                        (mux skid_v 1 (mux fire_in 1 0))
                        (mux fire_in 1 v)))
           (set! d (mux fire_out
                        (mux skid_v skid_d (mux fire_in (bits s_in) d))
                        (mux (and fire_in (not v)) (bits s_in) d)))
           (set! skid_v (mux fire_out
                             0
                             (mux (and fire_in v) 1 skid_v)))
           (set! skid_d (mux (and (not fire_out) (and fire_in v))
                             (bits s_in)
                             skid_d)))))

(defmodule sync-fifo
  :params ((W 8) (DEPTH 4))
  :ports ((in s_in (stream (uint W)))
          (out s_out (stream (uint W))))
  :state ((rd :type (uint (clog2 DEPTH)) :init 0)
          (wr :type (uint (clog2 DEPTH)) :init 0)
          (count :type (uint (+ (clog2 DEPTH) 1)) :init 0))
  :tables ((mem :depth DEPTH :type (uint W) :ports (:r 1 :w 1) :latency 0))
  :comb ((wire empty (uint 1) (== count 0))
         (wire full (uint 1) (== count DEPTH))
         (wire do_push (uint 1) (and (valid s_in) (not full)))
         (wire do_pop (uint 1) (and (ready s_out) (not empty)))
         (assign (ready s_in) (not full))
         (assign (valid s_out) (not empty))
         (assign (bits s_out) (table-read mem rd)))
  (defrule push_only
    :guard (and do_push (not do_pop))
    :body ((table-write mem wr (bits s_in))
           (set! wr (+ wr 1))
           (set! count (+ count 1))))
  (defrule pop_only
    :guard (and do_pop (not do_push))
    :body ((set! rd (+ rd 1))
           (set! count (- count 1))))
  (defrule both
    :guard (and do_push do_pop)
    :body ((table-write mem wr (bits s_in))
           (set! wr (+ wr 1))
           (set! rd (+ rd 1)))))

(defmodule async-fifo
  :clocks (clk_w clk_r)
  :params ((W 8) (DEPTH 4))
  :ports ((in s_in (stream (uint W)))
          (out s_out (stream (uint W))))
  :state ((wr_bin :type (uint (+ (clog2 DEPTH) 1)) :init 0 :clock clk_w)
          (wr_gray :type (uint (+ (clog2 DEPTH) 1)) :init 0 :clock clk_w)
          (rd_bin :type (uint (+ (clog2 DEPTH) 1)) :init 0 :clock clk_r)
          (rd_gray :type (uint (+ (clog2 DEPTH) 1)) :init 0 :clock clk_r)
          (wr_gray_r1 :type (uint (+ (clog2 DEPTH) 1)) :init 0 :clock clk_r)
          (wr_gray_r2 :type (uint (+ (clog2 DEPTH) 1)) :init 0 :clock clk_r)
          (rd_gray_w1 :type (uint (+ (clog2 DEPTH) 1)) :init 0 :clock clk_w)
          (rd_gray_w2 :type (uint (+ (clog2 DEPTH) 1)) :init 0 :clock clk_w))
  :tables ((mem :depth DEPTH :type (uint W) :ports (:r 1 :w 1) :latency 0 :clock clk_w))
  :comb ((wire aw (uint (clog2 DEPTH)) (bits wr_bin (- (clog2 DEPTH) 1) 0))
         (wire ar (uint (clog2 DEPTH)) (bits rd_bin (- (clog2 DEPTH) 1) 0))
         (wire empty (uint 1) (== rd_gray wr_gray_r2))
         (wire full (uint 1)
               (and (== (bits wr_gray (- (+ (clog2 DEPTH) 1) 1) (- (+ (clog2 DEPTH) 1) 2))
                        (~ (bits rd_gray_w2 (- (+ (clog2 DEPTH) 1) 1) (- (+ (clog2 DEPTH) 1) 2))))
                    (== (bits wr_gray (- (+ (clog2 DEPTH) 1) 3) 0)
                        (bits rd_gray_w2 (- (+ (clog2 DEPTH) 1) 3) 0))))
         (wire do_push (uint 1) (and (valid s_in) (not full)))
         (wire do_pop (uint 1) (and (ready s_out) (not empty)))
         (assign (ready s_in) (not full))
         (assign (valid s_out) (not empty))
         (assign (bits s_out) (table-read mem ar)))
  (defrule push
    :guard do_push
    :body ((table-write mem aw (bits s_in))
           (set! wr_bin (+ wr_bin 1))
           (set! wr_gray (^ (+ wr_bin 1) (>> (+ wr_bin 1) 1)))))
  (defrule pop
    :guard do_pop
    :body ((set! rd_bin (+ rd_bin 1))
           (set! rd_gray (^ (+ rd_bin 1) (>> (+ rd_bin 1) 1)))))
  (defrule sync_w
    :guard 1
    :body ((set! rd_gray_w1 rd_gray)
           (set! rd_gray_w2 rd_gray_w1)))
  (defrule sync_r
    :guard 1
    :body ((set! wr_gray_r1 wr_gray)
           (set! wr_gray_r2 wr_gray_r1))))

(defmodule elastic-pipeline
  :params ((W 8) (N 2))
  :ports ((in s_in (stream (uint W)))
          (out s_out (stream (uint W))))
  :state ((gen-for (i 0 N)
            ((symcat 'full_ i) :type (uint 1) :init 0)
            ((symcat 'data_ i) :type (uint W) :init 0 :reset-less t)))
  :comb ((gen-for (k 0 N)
           (wire (symcat 'rdy_ (- (- N 1) k)) (uint 1)
                 (or (not (symcat 'full_ (- (- N 1) k)))
                     (if (= k 0)
                         (ready s_out)
                         (symcat 'rdy_ (- N k))))))
         (gen-for (i 0 N)
           (wire (symcat 'vin_ i) (uint 1)
                 (if (= i 0) (valid s_in) (symcat 'full_ (- i 1))))
           (wire (symcat 'bin_ i) (uint W)
                 (if (= i 0) (bits s_in) (symcat 'data_ (- i 1))))
           (wire (symcat 'vordy_ i) (uint 1)
                 (if (= i (- N 1)) (ready s_out) (symcat 'rdy_ (+ i 1)))))
         (assign (valid s_out) (symcat 'full_ (- N 1)))
         (assign (bits s_out) (symcat 'data_ (- N 1)))
         (assign (ready s_in) (symcat 'rdy_ 0)))
  (gen-for (i 0 N)
    (defrule (symcat 'load_ i)
      :guard (and (symcat 'vin_ i) (symcat 'rdy_ i))
      :body ((set! (symcat 'data_ i) (symcat 'bin_ i))))
    (defrule (symcat 'upd_ i)
      :guard 1
      :body ((set! (symcat 'full_ i)
                   (or (and (symcat 'vin_ i) (symcat 'rdy_ i))
                       (and (symcat 'full_ i) (not (symcat 'vordy_ i)))))))))

(defmacro stream-slice (kind name W)
  (define k
    (let ((s (if (symbol? kind) (symbol->string kind) (format "~a" kind))))
      (string->symbol (if (and (positive? (string-length s)) (equal? (substring s 0 1) ":"))
                          (substring s 1)
                          s))))
  (unless (memq k '(forward backward skid))
    (error "stream-slice kind must be :forward, :backward, or :skid"))
  `(defmodule ,name
     :ports ((in s_in (stream (uint ,W)))
             (out s_out (stream (uint ,W))))
     :instances ((u ,(string->symbol (format "stream-slice-~a" k)) :params ((W ,W))))
     :comb ((assign (valid u.s_in) (valid s_in))
            (assign (bits u.s_in) (bits s_in))
            (assign (ready s_in) (ready u.s_in))
            (assign (valid s_out) (valid u.s_out))
            (assign (bits s_out) (bits u.s_out))
            (assign (ready u.s_out) (ready s_out)))))
